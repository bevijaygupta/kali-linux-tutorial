# Local environment template. Copy to .env and fill in only what you need.
# fetch_playlist.py and update_repository.py load .env automatically; variables
# already exported in your shell take precedence.
# Never commit .env or real credentials. GitHub Actions uses repository secrets.

# ---------------------------------------------------------------------------
# Playlist source
# ---------------------------------------------------------------------------
# Optional. With a key, fetch_playlist.py uses the official YouTube Data API v3.
# Without a key, it falls back to public playlist and watch pages (best effort).
YOUTUBE_API_KEY=

# Override the playlist URL or ID if you are working on a different course.
PLAYLIST_URL=https://www.youtube.com/playlist?list=PLYDHfwsEk0RY

# ---------------------------------------------------------------------------
# Optional AI-assisted drafts
# ---------------------------------------------------------------------------
# Only used by: python scripts/update_repository.py --enrich
# Drafts are written to data/curriculum-drafts.json with review_required=true.
# They are never published automatically. Provide one provider, not both.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Jekyll (optional)
# ---------------------------------------------------------------------------
JEKYLL_ENV=development
